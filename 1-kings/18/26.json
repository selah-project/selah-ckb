{"tier":"glm-5.2","verse":26,"ref":"1-kings 18:26","book":"1-kings","lang":"ckb","chapter":18,"translation":"و گوێرەکەیان کە بە دەمیان درابوو هەڵگرت، ⟨את⟩ گوێرەکەیان ئامادە کرد و بە ناوی بەعلیان بانگ کرد، لە بەیانییەوە تا نیوەڕۆ، بە وتنی: ئەی بەعل، وەڵامی بدەرەوە! و بێدەنگ بوو، هیچ دەنگێک نەبوو و هیچ وەڵامدەرێوە نەبوو، و لەسەر قوربانگاکەی کە درابوو سەریان دانا و هەڵدەپرکن.","tokens":[{"surface":"ויקחו","gloss":"و هەڵگرت"},{"surface":"את","gloss":"⟨את⟩","marks":"گوێرەکە"},{"surface":"הפר","gloss":"گوێرەکە"},{"surface":"אשר","gloss":"کە"},{"surface":"נתן","gloss":"درا"},{"surface":"להם","gloss":"بە دەمیان"},{"surface":"ויעשו","gloss":"و ئامادە کردن"},{"surface":"ויקראו","gloss":"و بانگیان کرد"},{"surface":"בשם","gloss":"بە ناوی"},{"surface":"הבעל","gloss":"بەعل"},{"surface":"מהבקר","gloss":"لە بەیانییەوە"},{"surface":"ועד","gloss":"و تا"},{"surface":"הצהרים","gloss":"نیوەڕۆ"},{"surface":"לאמר","gloss":"بە وتنی"},{"surface":"הבעל","gloss":"بەعل"},{"surface":"עננו","gloss":"وەڵامی بدەرەوە"},{"surface":"ואין","gloss":"و نەبوو"},{"surface":"קול","gloss":"دەنگ"},{"surface":"ואין","gloss":"و نەبوو"},{"surface":"ענה","gloss":"وەڵامدەر"},{"surface":"ויפסחו","gloss":"و هەڵدەپرکن"},{"surface":"על","gloss":"لەسەر"},{"surface":"המזבח","gloss":"قوربانگاکە"},{"surface":"אשר","gloss":"کە"},{"surface":"עשה","gloss":"درا"}],"timestamp":"2026-09-24T11:57:29.927931152Z","model":"glm-5.3"}